# Agent
AGENT_PROVIDER=kimi
KIMI_COMMAND=kimi
KIMI_TIMEOUT_SECONDS=900
CODEX_COMMAND=codex
CODEX_TIMEOUT_SECONDS=900
CODEX_SEARCH_ENABLED=true
CODEX_SANDBOX=danger-full-access
CODEX_APPROVAL_POLICY=never
WORKER_AGENT_TIMEOUT_SECONDS=180
KIMI_AUTO_APPROVE_TOOLS=false

# Polymarket public read APIs only
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
WEB_RESEARCH_HEALTH_URL=https://www.google.com/generate_204

# Runtime
RUNTIME_DIR=runtime
EVENT_PAGES_PER_SORT=0
EVENTS_PER_PAGE=50
GAMMA_REQUEST_RETRIES=3
GAMMA_RETRY_BACKOFF_MS=500
DISCOVERY_PARTIAL_MIN_CANDIDATES=500
DISCOVERY_CACHE_ENABLED=true
MIN_MARKET_LIQUIDITY_USD=5000
RESEARCH_WORKER_CONCURRENCY=0
MAX_FOLLOW_UP_TASKS_PER_CYCLE=50
MAX_FOLLOW_UP_DEPTH=1
DISCOVERY_HEALTH_TIMEOUT_SECONDS=600
SMOKE_MAX_CANDIDATES_PER_CYCLE=0
MAX_WORKER_FAILURE_RATE=0.5

# Paper portfolio
PAPER_STARTING_CASH_USD=500

# Risk and validation
MAX_SINGLE_TRADE_PCT=0.15
MAX_TOTAL_EXPOSURE_PCT=0.8
MAX_EVENT_EXPOSURE_PCT=0.3
MAX_POSITIONS=22
MIN_TRADE_USD=5
EDGE_THRESHOLD_PCT=0.05
MAX_REPAIR_ATTEMPTS=3
COORDINATOR_REPAIR_ATTEMPTS=1
WORKER_REPAIR_ATTEMPTS=5
REDUCER_REPAIR_ATTEMPTS=5
COORDINATOR_PRESCREEN_MAX_CANDIDATES=0
COORDINATOR_PRESCREEN_MIN_CANDIDATES=24
PRICE_TOLERANCE_PCT=0.03
STRATEGY_CLIP_MIN_RATIO=0.5

# Optional LLM judge
LLM_JUDGE_ENABLED=true
LLM_JUDGE_FORMAT_RETRY_COUNT=1
ALLOW_EXECUTION_WHEN_JUDGE_SKIPPED=true
